<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../fixtures/**/*.xml;../fixtures/**/*.pdf;../fixtures/**/*.json" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="WireMock.Net" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PaperPilot.Api/PaperPilot.Api.csproj" />
    <ProjectReference Include="../../src/PaperPilot.Core/PaperPilot.Core.csproj" />
    <ProjectReference Include="../../src/PaperPilot.Infrastructure/PaperPilot.Infrastructure.csproj" />
    <ProjectReference Include="../../src/PaperPilot.Ingestion/PaperPilot.Ingestion.csproj" />
    <ProjectReference Include="../../src/PaperPilot.Rag/PaperPilot.Rag.csproj" />
  </ItemGroup>

</Project>
